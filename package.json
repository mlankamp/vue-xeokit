{
  "name": "vue-xeokit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*"
  },
  "dependencies": {
    "@xeokit/xeokit-sdk": "2.6.114",
    "vue": "^3.5.44",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@tsconfig/node-lts": "latest",
    "@types/node": "~26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-oxlint": "^1.92.0",
    "eslint-plugin-vue": "^10.12.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.74.0",
    "sass": "^1.107.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "3.3.14"
  }
}
